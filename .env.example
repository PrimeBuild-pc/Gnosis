DATABASE_URL=postgresql://gnosis:gnosis@db:5432/gnosis
# Usato per gli embedding (deve produrre vettori da 1536 dimensioni) ed è il fallback per la chat.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Facoltativo: provider separato per la chat (classificazione, RAG, digest), compatibile OpenAI.
# Se vuoto, usa OPENAI_API_KEY/OPENAI_BASE_URL. Ricorda di impostare OPENAI_CHAT_MODEL con il
# nome modello del provider scelto. Esempi gratuiti: OpenRouter (https://openrouter.ai, modelli
# con suffisso ":free"), NVIDIA NIM (https://build.nvidia.com, free tier), Groq
# (https://console.groq.com, free tier).
GNOSIS_CHAT_API_KEY=
GNOSIS_CHAT_BASE_URL=

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=/data/telegram/gnosis
# Bot BotFather per interrogare Gnosis da Telegram con /ask e /digest (facoltativo).
TELEGRAM_BOT_TOKEN=
# ID utente Telegram numerici autorizzati a usare il bot, separati da virgola. Obbligatorio se
# TELEGRAM_BOT_TOKEN è impostato.
GNOSIS_TELEGRAM_ALLOWED_USERS=
DISCORD_BOT_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=gnosis-personal-kb/0.1

GNOSIS_USERNAME=admin
GNOSIS_PASSWORD=change-me
GNOSIS_HOST=127.0.0.1
GNOSIS_PORT=8080
GNOSIS_TIMEZONE=Europe/Rome
GNOSIS_SOURCES_FILE=config/sources.toml
GNOSIS_REDDIT_POLL_SECONDS=900
GNOSIS_PROCESS_SECONDS=10
GNOSIS_RELEVANCE_THRESHOLD=0.35
