# Docker Compose .env syntax. Installer/dashboard quote values and escape $ as $$.
# For manual credentials use simple alphanumeric values or proper dotenv escaping.
# Generate an alphanumeric password and repeat it in DATABASE_URL (see README).
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://gnosis:REPLACE_WITH_POSTGRES_PASSWORD@db:5432/gnosis

# Embeddings are local by default (fastembed, no key or API cost, multilingual
# sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 model, 384 dimensions).
# Set "openai" to use paid OpenAI embeddings instead (1536 dimensions: also update
# GNOSIS_EMBEDDING_DIMENSIONS and apply migrations/002_local_embeddings.sql accordingly).
GNOSIS_EMBEDDING_PROVIDER=local
GNOSIS_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
GNOSIS_EMBEDDING_DIMENSIONS=384

# Required only if GNOSIS_EMBEDDING_PROVIDER=openai, or as the chat fallback when
# GNOSIS_CHAT_API_KEY is empty.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: separate OpenAI-compatible chat provider (classification, RAG, digests).
# If empty, uses OPENAI_API_KEY/OPENAI_BASE_URL. Set OPENAI_CHAT_MODEL to the chosen
# provider's model name. Free-tier examples: OpenRouter (https://openrouter.ai, models
# with the ":free" suffix), NVIDIA NIM (https://build.nvidia.com, free tier), Groq
# (https://console.groq.com, free tier). Availability and quotas may change; see README.
GNOSIS_CHAT_API_KEY=
GNOSIS_CHAT_BASE_URL=

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=/data/telegram/gnosis
# Optional BotFather bot for querying Gnosis from Telegram with /ask and /digest.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to use the bot. Required if
# TELEGRAM_BOT_TOKEN is set. Authorize only operators allowed to see all sources.
GNOSIS_TELEGRAM_ALLOWED_USERS=
# Optional Telegram chat for automatically publishing the generated weekly digest
# (uses TELEGRAM_BOT_TOKEN). If empty, digests are available only on request.
# This global destination is used only when no workspaces exist; see README.
GNOSIS_DIGEST_TELEGRAM_CHAT_ID=

DISCORD_BOT_TOKEN=
# DEPRECATED: comma-separated role IDs are ignored by Discord commands. Configure an
# explicit workspace, server ID, and roles per server in the dashboard instead.
# Empty workspace roles deny access.
GNOSIS_DISCORD_ALLOWED_ROLE_IDS=
# Optional Discord channel webhook URL for automatically publishing weekly digests,
# independent of GNOSIS_DISCORD_ALLOWED_ROLE_IDS. Accepts ONE URL: with multiple servers,
# give each workspace its own webhook in the dashboard instead of listing URLs here.
GNOSIS_DIGEST_DISCORD_WEBHOOK=

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=gnosis-personal-kb/0.1

GNOSIS_USERNAME=admin
GNOSIS_PASSWORD=
GNOSIS_HOST=127.0.0.1
GNOSIS_PORT=8080
GNOSIS_TIMEZONE=Europe/Rome
GNOSIS_SOURCES_FILE=config/sources.toml
GNOSIS_REDDIT_POLL_SECONDS=900
GNOSIS_PROCESS_SECONDS=10
GNOSIS_RELEVANCE_THRESHOLD=0.35

# Other Prime Build bots already installed, as comma-separated id=address entries.
# The dashboard shows reachable bots instead of gray placeholders; click to switch.
# Informational only: Gnosis does not query their data or administer them.
# GNOSIS_BOTS=doorman=http://127.0.0.1:3000,dview=http://127.0.0.1:3001
GNOSIS_BOTS=
